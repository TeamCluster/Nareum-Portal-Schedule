# 비밀값 — .env 는 이미지에 절대 굽지 않는다. 이미지 레이어에 남아 배포처마다
# 따라다니게 된다. 런타임에 compose 의 env_file 로 주입한다.
.env

# 로컬 데이터 — 개발용 SQLite 나 업로드 이미지가 이미지에 섞여 들어가면
# 첫 배포에서 남의 예약 데이터가 딸려 온다.
# static/img (기본 시설 사진)는 이미지에 포함해야 하므로 제외하지 않는다.
db
backups
static/*/facility
static/*/header.*

# 개발 부산물
.venv
__pycache__
*.py[cod]
.pytest_cache
.git
.gitignore
.DS_Store

# 이미지 안에서 쓰지 않는 것
docker-compose.yml
requirements-dev.txt
