# Copy to .env and adjust for your environment.
#
# ── 배포 전 반드시 바꿀 값 ───────────────────────────────
#   1) SECRET_KEY     아래 명령으로 랜덤 생성한 값으로 교체
#   2) MANAGE_PASSWORD 관리자 비밀번호
#   3) CORS_ORIGINS   프론트 실제 도메인
#   4) 크로스사이트 HTTPS 배포면 SESSION_COOKIE_SAMESITE=None, SESSION_COOKIE_SECURE=true
# ────────────────────────────────────────────────────────

# Flask session signing key. MUST be changed in production.
# 생성:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# Admin password for the /manage area. MUST be changed in production.
MANAGE_PASSWORD=manage123

# Database. Defaults to local SQLite; swap for Postgres etc.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/nareum
DATABASE_URL=sqlite:///resv.db

# Frontend origins allowed to call the API with credentials (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie settings. For cross-site SPA over HTTPS in production use:
#   SESSION_COOKIE_SAMESITE=None
#   SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# Booking window (days from today).
BOOKING_MIN_DAYS=3
BOOKING_MAX_DAYS=14

SERVICE_NAME=나름센터 활동실 대관
