# 이 파일을 .env 로 복사해 쓰면 config.py 가 임포트 시 자동으로 읽습니다
# (python-dotenv). 이미 셸/systemd 로 넣은 환경변수가 있으면 그쪽이 우선입니다.
# 설정 없이도 첫 실행 시 슈퍼 비밀번호/SECRET_KEY 는 자동 생성됩니다(콘솔 1회 출력).
#
# ⚠️ .env 에는 비밀번호가 들어가므로 절대 커밋하지 마세요(.gitignore 에 포함됨).

# --- 첫 부트스트랩 초기값 (이미 DB 에 있으면 무시됨) ---
# 지정하면 슈퍼 임시 비번을 랜덤 대신 이 값으로 생성.
# SUPER_PASSWORD=change-me-super
# 기본 기관(nareum) 관리자 임시 비밀번호 (기본값 manage123).
# DEFAULT_PLACE_PASSWORD=
# 세션 서명키. 미지정 시 자동 랜덤 생성 후 db/super.sqlite3 에 저장.
# 생성 예:  python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# --- 배포 환경값 ---
# 프론트 실제 도메인(콤마 구분).
# 프론트를 Cloudflare Pages 프록시(_worker.js)로 붙이면 same-origin 이라
# CORS 자체가 관여하지 않습니다 — 그 구성에서는 이 값이 쓰이지 않습니다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# HTTPS 배포면 SECURE=true. SAMESITE 는 same-origin 프록시면 Lax 로 충분하고,
# 프론트/백 도메인이 다른 cross-site 라면 None 이어야 합니다.
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# --- 전송 구간 보안 (HTTPS/TLS) ---
# 비밀번호는 저장 시 이미 해시되며, 아래는 "전송 중" 노출을 막는 설정.
#
# [운영 HTTPS 프리셋] — TLS 를 붙였다면 아래처럼 켜세요:
#   SESSION_COOKIE_SECURE=true      # 쿠키를 HTTPS 로만 전송
#   FORCE_HTTPS=true                # HTTP 요청을 HTTPS 로 301 리다이렉트
#   TRUSTED_PROXY_HOPS=1            # nginx 등 리버스 프록시 뒤라면 1 (없으면 0)
#   HSTS_MAX_AGE=31536000          # 안정화 후 켜기(1년). 0 이면 미사용
#   HSTS_INCLUDE_SUBDOMAINS=false  # 서브도메인 전체 HTTPS 강제 시 true
#
# cross-site(프론트/백 도메인 다름) HTTPS 면 추가로:
#   SESSION_COOKIE_SAMESITE=None    # ← 값은 Strict/Lax/None. true/false 아님!
#
# ⚠️ TRUSTED_PROXY_HOPS 는 X-Forwarded-For 기준입니다.
#    Cloudflare(주황 구름) + 시놀로지 역방향 프록시 = 2, 프록시 1대 = 1, 없으면 0.
#    Proto/Host 헤더는 보통 덮어쓰기라 값이 1개뿐이므로 별도 변수를 씁니다
#    (TRUSTED_PROTO_HOPS / TRUSTED_HOST_HOPS, 기본 1). 보통 건드릴 필요 없습니다.
FORCE_HTTPS=false
TRUSTED_PROXY_HOPS=0
HSTS_MAX_AGE=0
HSTS_INCLUDE_SUBDOMAINS=false
ENABLE_SECURITY_HEADERS=true

# 로컬에서 HTTPS 를 테스트하려면(자체서명 인증서, cryptography 패키지 필요):
#   DEV_HTTPS=true
# DEV_HTTPS=false

# --- 로그인 시도 제한 (무차별 대입 방어) ---
# 같은 IP 가 WINDOW 초 안에 MAX 회 실패하면 LOCKOUT 초 동안 잠깁니다.
# ⚠️ 프록시 뒤라면 TRUSTED_PROXY_HOPS 를 반드시 1 이상으로 두세요. 0 이면 모든
#    요청이 프록시 IP 하나로 집계되어 이용자 전체가 함께 잠깁니다.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# --- 업로드 ---
# 요청 본문 전체 상한(바이트). 이미지 자체 상한은 5MB 이며 여유분을 둔 값입니다.
MAX_CONTENT_LENGTH=6291456

# --- 운영 서버 (gunicorn.conf.py) ---
# BIND=127.0.0.1:8000
# WEB_WORKERS=2
# WEB_THREADS=4

# --- 예약 규칙 (기본값으로 충분) ---
BOOKING_MIN_DAYS=3
BOOKING_MAX_DAYS=14
SERVICE_NAME=나름센터 활동실 대관

# --- 경로 ---
# 기본값은 앱 디렉터리 안(BackEnd/db, BackEnd/static)입니다.
# 시놀로지 NAS·VPS 처럼 프로젝트 폴더 자체가 보존되는 환경이면 그대로 두세요.
# 데이터를 다른 디스크/볼륨에 두고 싶을 때만 지정합니다.
# DB_FOLDER=/volume1/docker/nareum/db
# STATIC_ROOT=/volume1/docker/nareum/static

# 컨테이너 안에서 앱 디렉터리에 데이터를 두면 부팅 시 경고가 나옵니다.
# 바인드 마운트를 확인했다면 아래로 경고를 끕니다.
# STORAGE_PERSISTENT=true

# --- 백업 (scripts/backup.py) ---
# 기본 출력 위치는 BackEnd/backups/ 입니다(File Station 에서 바로 열람 가능).
# ⚠️ 가동 중에는 db/*.sqlite3 를 직접 복사하지 말고 이 스냅샷을 받으세요.
#    WAL 모드라 최근 예약이 -wal 파일에만 있을 수 있습니다. 배포 가이드 2장 참고.
# BACKUP_DIR=/volume1/backup/nareum
# BACKUP_KEEP=14
