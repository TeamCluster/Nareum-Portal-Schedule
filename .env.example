# 이 파일은 선택 사항입니다. 설정 없이도 첫 실행 시 슈퍼 비밀번호/SECRET_KEY 가
# 자동 생성됩니다(콘솔 1회 출력). 배포 환경값만 필요에 따라 지정하세요.
# 셸 환경변수로 넣거나(권장) python-dotenv 등으로 로드해 사용.

# --- 첫 부트스트랩 초기값 (이미 DB 에 있으면 무시됨) ---
# 지정하면 슈퍼 임시 비번을 랜덤 대신 이 값으로 생성.
# SUPER_PASSWORD=change-me-super
# 기본 기관(nareum) 관리자 임시 비밀번호 (기본값 manage123).
# DEFAULT_PLACE_PASSWORD=change-me-place
# 세션 서명키. 미지정 시 자동 랜덤 생성 후 db/super.sqlite3 에 저장.
# 생성 예:  python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# --- 배포 환경값 ---
# 프론트 실제 도메인(콤마 구분).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# cross-site HTTPS 배포면 아래 둘을 켜세요.
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# --- 전송 구간 보안 (HTTPS/TLS) ---
# 비밀번호는 저장 시 이미 해시되며, 아래는 "전송 중" 노출을 막는 설정.
#
# [운영 HTTPS 프리셋] — TLS 를 붙였다면 아래처럼 켜세요:
#   SESSION_COOKIE_SECURE=true      # 쿠키를 HTTPS 로만 전송
#   FORCE_HTTPS=true                # HTTP 요청을 HTTPS 로 301 리다이렉트
#   TRUSTED_PROXY_HOPS=1            # nginx 등 리버스 프록시 뒤라면 1 (없으면 0)
#   HSTS_MAX_AGE=31536000          # 안정화 후 켜기(1년). 0 이면 미사용
#   HSTS_INCLUDE_SUBDOMAINS=false  # 서브도메인 전체 HTTPS 강제 시 true
#
# cross-site(프론트/백 도메인 다름) HTTPS 면 추가로:
#   SESSION_COOKIE_SAMESITE=None
FORCE_HTTPS=false
TRUSTED_PROXY_HOPS=0
HSTS_MAX_AGE=0
HSTS_INCLUDE_SUBDOMAINS=false
ENABLE_SECURITY_HEADERS=true

# 로컬에서 HTTPS 를 테스트하려면(자체서명 인증서, cryptography 패키지 필요):
#   DEV_HTTPS=true
# DEV_HTTPS=false

# --- 예약 규칙 (기본값으로 충분) ---
BOOKING_MIN_DAYS=3
BOOKING_MAX_DAYS=14
SERVICE_NAME=나름센터 활동실 대관

# --- 경로 (테스트/특수 배포용, 보통 불필요) ---
# DB_FOLDER=/var/lib/nareum/db
