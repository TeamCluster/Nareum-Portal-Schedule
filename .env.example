# Copy to .env and adjust for your environment.

# Flask session signing key. MUST be changed in production.
SECRET_KEY=change-me-to-a-random-string

# Admin password for the /manage area.
MANAGE_PASSWORD=manage123

# Database. Defaults to local SQLite; swap for Postgres etc.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/nareum
DATABASE_URL=sqlite:///resv.db

# Frontend origins allowed to call the API with credentials (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie settings. For cross-site SPA over HTTPS in production use:
#   SESSION_COOKIE_SAMESITE=None
#   SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# Booking window (days from today).
BOOKING_MIN_DAYS=3
BOOKING_MAX_DAYS=14

SERVICE_NAME=나름센터 활동실 대관
